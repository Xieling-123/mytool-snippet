{
  "github更新项目.sh": {
    "prefix": "github更新项目.sh",
    "body": [
      "#!/bin/bash",
      "# ============================================================",
      "# 使用方法：使用 Git Bash 终端，cd 到对应的文件路径，",
      "# 在对应的路径里面建立：github更新项目.sh",
      "# 使用用法：bash github更新项目.sh \"为什么更新写这里吗\" ",
      "# ============================================================",
      "",
      "set -e",
      "",
      "# 默认提交信息",
      "DEFAULT_COMMIT_MSG=\"日常更新 \\$(date '+%Y-%m-%d %H:%M:%S')\"",
      "COMMIT_MSG=\"\\${1:-\\$DEFAULT_COMMIT_MSG}\"",
      "",
      "echo \"📝 提交信息：\\$COMMIT_MSG\"",
      "",
      "# 检查是否在 Git 仓库中",
      "if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then",
      "    echo \"❌ 当前目录不是 Git 仓库\"",
      "    exit 1",
      "fi",
      "",
      "# 格式化当前目录下所有 Python 文件（使用 Black）",
      "echo \"🎨 运行 Black 格式化...\"",
      "black .",
      "",
      "# 检查是否有更改（包括格式化产生的改动）",
      "if [[ -z \\$(git status --porcelain) ]]; then",
      "    echo \"✅ 没有需要提交的更改\"",
      "    exit 0",
      "fi",
      "",
      "# 显示状态",
      "echo \"----- 待提交的文件 -----\"",
      "git status --short",
      "echo \"------------------------\"",
      "",
      "# 添加所有更改",
      "git add .",
      "",
      "# 提交",
      "git commit -m \"\\$COMMIT_MSG\"",
      "",
      "# 推送（自动识别分支）",
      "BRANCH=\\$(git symbolic-ref --short HEAD 2>/dev/null || echo \"master\")",
      "echo \"🚀 推送到 origin/\\$BRANCH ...\"",
      "git push origin \"\\$BRANCH\"",
      "",
      "echo \"🎉 更新完成！\""
    ],
    "description": "提交前会自动美化，任何项目都可以保存这个文件，然后双击运行实现自动同步github(需要有仓库有项目框架)"
  },
  "新建项目.sh": {
    "prefix": "新建项目.sh",
    "body": [
      "#!/bin/bash",
      "# ============使用方法======================",
      "# 一键初始化 Python 项目并推送到 GitHub",
      "",
      "# 1、使用前请修改下面 4 个变量",
      "",
      "# 2、使用gitbash的终端，在对应的路径里面建立：新建项目.sh把对应的代码复制进去",
      "",
      "# 3、cd到对应的文件路径，再bash 新建项目.sh",
      "",
      "# ============= 必填配置 =============",
      "PROJECT_NAME=\"python-project-base\" ",
      "#项目名称",
      "PROJECT_PATH=\"D:/mytool/01_doc/doc-python\"   ",
      "# 注意：使用正斜杠,到根目录就行,会自己创建一个文件",
      "REPO_URL=\"https://github.com/Xieling-123/python-project-base.git\" ",
      "# github新建",
      "CREATE_VENV=\"yes\" ",
      "# 虚拟环境",
      "",
      "#=============项目删除：gitbash终端=================",
      "# cd到对应的文件路径，执行代码 ",
      "# cd /d/mytool/01_doc/doc-python/base   # 你的父目录",
      "# ls -la # 文件查看",
      "# 永久删除",
      "# rm -rf python-project-base   # 替换为你的项目名，直接使用绝对路径也行",
      "# 删除github上面的仓库地址",
      "",
      "",
      "#==============代码===============",
      "",
      "set -e",
      "",
      "echo \"🚀 开始自动初始化项目：\\$PROJECT_NAME\"",
      "",
      "# 1. 进入父目录并创建项目文件夹",
      "mkdir -p \"\\$PROJECT_PATH\"",
      "cd \"\\$PROJECT_PATH\"",
      "mkdir -p \"\\$PROJECT_NAME\"",
      "cd \"\\$PROJECT_NAME\"",
      "echo \"✅ 项目目录：\\$(pwd)\"",
      "",
      "# 2. 创建目录结构（可在此处增删）",
      "mkdir -p src tests docs scripts",
      "touch src/__init__.py",
      "",
      "# 3. 生成 main.py",
      "cat > src/main.py << 'EOF'",
      "\"\"\"项目入口模块\"\"\"",
      "",
      "def main():",
      "    print(\"Hello from \\$PROJECT_NAME!\")",
      "",
      "if __name__ == \"__main__\":",
      "    main()",
      "EOF",
      "",
      "# 4. 生成 .gitignore",
      "cat > .gitignore << 'EOF'",
      "# Python",
      "__pycache__/",
      "*.py[cod]",
      "*.so",
      ".Python",
      "venv/",
      "env/",
      "ENV/",
      ".venv",
      ".idea/",
      ".vscode/",
      "*.log",
      "*.pid",
      "*.seed",
      "*.pid.lock",
      ".DS_Store",
      "dist/",
      "build/",
      "*.egg-info/",
      ".eggs/",
      ".pytest_cache/",
      ".coverage",
      "htmlcov/",
      ".tox/",
      ".mypy_cache/",
      ".dmypy.json",
      "dmypy.json",
      "*.prof",
      "EOF",
      "",
      "# 5. 生成 pyproject.toml",
      "cat > pyproject.toml << EOF",
      "[build-system]",
      "requires = [\"setuptools>=61.0\", \"wheel\"]",
      "build-backend = \"setuptools.build_meta\"",
      "",
      "[project]",
      "name = \"\\$PROJECT_NAME\"",
      "version = \"0.1.0\"",
      "description = \"A Python project\"",
      "authors = [{name = \"Your Name\"}]",
      "readme = \"README.md\"",
      "license = {text = \"MIT\"}",
      "requires-python = \">=3.8\"",
      "dependencies = []",
      "",
      "[tool.setuptools.packages.find]",
      "where = [\"src\"]",
      "EOF",
      "",
      "# 6. 生成 README.md",
      "cat > README.md << EOF",
      "# \\$PROJECT_NAME",
      "",
      "## 安装",
      "",
      "\\`\\`\\`bash",
      "python -m venv venv",
      "source venv/Scripts/activate  # Windows Git Bash",
      "# 或 source venv/bin/activate  # Linux/Mac",
      "pip install -e .",
      "\\`\\`\\`",
      "",
      "## 运行",
      "",
      "\\`\\`\\`bash",
      "python src/main.py",
      "\\`\\`\\`",
      "EOF",
      "",
      "# 7. 生成 LICENSE",
      "cat > LICENSE << EOF",
      "MIT License",
      "",
      "Copyright (c) \\$(date +%Y) Your Name",
      "",
      "Permission is hereby granted, free of charge, to any person obtaining a copy",
      "of this software and associated documentation files (the \"Software\"), to deal",
      "in the Software without restriction, including without limitation the rights",
      "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell",
      "copies of the Software, and to permit persons to whom the Software is",
      "furnished to do so, subject to the following conditions:",
      "",
      "The above copyright notice and this permission notice shall be included in all",
      "copies or substantial portions of the Software.",
      "",
      "THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR",
      "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,",
      "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE",
      "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER",
      "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,",
      "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE",
      "SOFTWARE.",
      "EOF",
      "",
      "# 8. 初始化 Git 并首次提交",
      "if [ -d \".git\" ]; then",
      "    echo \"⚠️ 当前目录已是 Git 仓库，跳过 git init\"",
      "else",
      "    git init",
      "    git add .",
      "    git commit -m \"🎉 初始项目骨架\"",
      "    echo \"✅ Git 仓库已初始化并完成首次提交\"",
      "fi",
      "",
      "# 9. 可选创建虚拟环境",
      "if [ \"\\$CREATE_VENV\" = \"yes\" ]; then",
      "    echo \"🐍 创建虚拟环境...\"",
      "    python -m venv venv",
      "",
      "    # 确定虚拟环境 Python 解释器路径",
      "    if [[ \"\\$OSTYPE\" == \"msys\" || \"\\$OSTYPE\" == \"cygwin\" ]]; then",
      "        PYTHON_EXE=\"venv/Scripts/python.exe\"",
      "    else",
      "        PYTHON_EXE=\"venv/bin/python\"",
      "    fi",
      "",
      "    # 使用官方 PyPI 源（避免镜像源问题）",
      "    echo \"📦 升级 pip 和 setuptools ...\"",
      "    \\$PYTHON_EXE -m pip install --upgrade pip setuptools wheel -i https://pypi.org/simple",
      "",
      "    echo \"📦 安装项目（可编辑模式）...\"",
      "    \\$PYTHON_EXE -m pip install -e . -i https://pypi.org/simple || {",
      "        echo \"⚠️ 项目安装失败，但脚本将继续执行推送步骤\"",
      "    }",
      "    echo \"✅ 虚拟环境创建完成\"",
      "fi",
      "",
      "# 10. 关联远程仓库并推送（自动识别分支，处理 remote 已存在的情况）",
      "if git remote | grep -q \"^origin\\$\"; then",
      "    echo \"⚠️ 远程 origin 已存在，更新 URL 为 \\$REPO_URL\"",
      "    git remote set-url origin \"\\$REPO_URL\"",
      "else",
      "    git remote add origin \"\\$REPO_URL\"",
      "fi",
      "",
      "BRANCH=\\$(git symbolic-ref --short HEAD 2>/dev/null || echo \"master\")",
      "echo \"🚀 推送到 origin/\\$BRANCH ...\"",
      "",
      "# 如果远程仓库已有内容，可能推送失败，这里给出提示",
      "if ! git push -u origin \"\\$BRANCH\"; then",
      "    echo \"❌ 推送失败，可能是远程仓库非空或网络问题。\"",
      "    echo \"   你可以尝试：\"",
      "    echo \"   1. 如果是非空仓库，先拉取合并： git pull --rebase origin \\$BRANCH\"",
      "    echo \"   2. 检查网络或凭据。\"",
      "    exit 1",
      "fi",
      "",
      "echo \"\"",
      "echo \"🎉 项目初始化完成并已推送到 GitHub！\"",
      "echo \"📂 项目路径：\\$(pwd)\"",
      "echo \"🐍 虚拟环境激活命令：\"",
      "if [[ \"\\$OSTYPE\" == \"msys\" || \"\\$OSTYPE\" == \"cygwin\" ]]; then",
      "    echo \"   source venv/Scripts/activate\"",
      "else",
      "    echo \"   source venv/bin/activate\"",
      "fi"
    ],
    "description": "首先创建github仓库，快速建立一个python项目的普通框架自动上传github备份，结合github项目更新.sh实现项目自动存储"
  },
  "删除项目": {
    "prefix": "删除项目",
    "body": [
      "# rm -rf python-project-base   # 替换为你的项目名，直接使用绝对路径也行"
    ],
    "description": "永久删除，使用绝对路径，github仓库另外删除"
  }
}