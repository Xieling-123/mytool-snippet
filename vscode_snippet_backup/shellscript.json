{
  "github更新项目.sh": {
    "prefix": "github更新项目.sh",
    "body": [
      "#!/bin/bash",
      "# ============================================================",
      "#使用方法：使用gitbash的终端，cd 到对应的文件路径，在对应的路径里面建立：github更新项目.sh",
      "#使用用法：bash github更新项目.sh \"为什么更新写这里吗\" ",
      "# ============================================================",
      "",
      "set -e",
      "",
      "# 默认提交信息",
      "DEFAULT_COMMIT_MSG=\"日常更新 \\$(date '+%Y-%m-%d %H:%M:%S')\"",
      "COMMIT_MSG=\"\\${1:-\\$DEFAULT_COMMIT_MSG}\"",
      "",
      "echo \"📝 提交信息：\\$COMMIT_MSG\"",
      "",
      "# 检查是否在 Git 仓库中",
      "if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then",
      "    echo \"❌ 当前目录不是 Git 仓库\"",
      "    exit 1",
      "fi",
      "",
      "# 检查是否有更改",
      "if [[ -z \\$(git status --porcelain) ]]; then",
      "    echo \"✅ 没有需要提交的更改\"",
      "    exit 0",
      "fi",
      "",
      "# 显示状态",
      "echo \"----- 待提交的文件 -----\"",
      "git status --short",
      "echo \"------------------------\"",
      "",
      "# 添加、提交、推送",
      "git add .",
      "git commit -m \"\\$COMMIT_MSG\"",
      "BRANCH=\\$(git symbolic-ref --short HEAD 2>/dev/null || echo \"master\")",
      "echo \"🚀 推送到 origin/\\$BRANCH ...\"",
      "git push origin \"\\$BRANCH\"",
      "",
      "echo \"🎉 更新完成！\""
    ],
    "description": "任何项目都可以保存这个文件，然后双击运行实现自动同步github(需要有仓库有项目框架)"
  }
}