{
  "github更新项目.sh": {
    "prefix": "github更新项目.sh",
    "body": [
      "#!/bin/bash",
      "# ============================================================",
      "# 使用方法：使用 Git Bash 终端，cd 到对应的文件路径，",
      "# 在对应的路径里面建立：github更新项目.sh",
      "# 使用用法：bash github更新项目.sh \"为什么更新写这里吗\" ",
      "# ============================================================",
      "",
      "set -e",
      "",
      "# 默认提交信息",
      "DEFAULT_COMMIT_MSG=\"日常更新 \\$(date '+%Y-%m-%d %H:%M:%S')\"",
      "COMMIT_MSG=\"\\${1:-\\$DEFAULT_COMMIT_MSG}\"",
      "",
      "echo \"📝 提交信息：\\$COMMIT_MSG\"",
      "",
      "# 检查是否在 Git 仓库中",
      "if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then",
      "    echo \"❌ 当前目录不是 Git 仓库\"",
      "    exit 1",
      "fi",
      "",
      "# 格式化当前目录下所有 Python 文件（使用 Black）",
      "echo \"🎨 运行 Black 格式化...\"",
      "black .",
      "",
      "# 检查是否有更改（包括格式化产生的改动）",
      "if [[ -z \\$(git status --porcelain) ]]; then",
      "    echo \"✅ 没有需要提交的更改\"",
      "    exit 0",
      "fi",
      "",
      "# 显示状态",
      "echo \"----- 待提交的文件 -----\"",
      "git status --short",
      "echo \"------------------------\"",
      "",
      "# 添加所有更改",
      "git add .",
      "",
      "# 提交",
      "git commit -m \"\\$COMMIT_MSG\"",
      "",
      "# 推送（自动识别分支）",
      "BRANCH=\\$(git symbolic-ref --short HEAD 2>/dev/null || echo \"master\")",
      "echo \"🚀 推送到 origin/\\$BRANCH ...\"",
      "git push origin \"\\$BRANCH\"",
      "",
      "echo \"🎉 更新完成！\""
    ],
    "description": "提交前会自动美化，任何项目都可以保存这个文件，然后双击运行实现自动同步github(需要有仓库有项目框架)"
  },
  "新建项目.sh": {
    "prefix": "新建项目.sh",
    "body": [
      "#!/bin/bash",
      "# ============使用方法======================",
      "# 一键初始化 Python 项目并推送到 GitHub",
      "",
      "# 1、使用前请修改下面 4 个变量",
      "# 2、使用 Git Bash 终端，在对应路径建立：新建项目.sh，复制代码进去",
      "# 3、cd 到脚本所在目录，执行：bash 新建项目.sh",
      "",
      "# ============= 必填配置 =============",
      "PROJECT_NAME=\"python-project-base\"",
      "# 项目名称（本地文件夹名，也会作为 Python 包名，请使用合法标识符）",
      "PROJECT_PATH=\"D:/mytool/01_doc/doc-python\"",
      "# 父目录，项目将创建在此目录下（支持 Windows 盘符格式，脚本会自动转换）",
      "REPO_URL=\"https://github.com/Xieling-123/python-project-base.git\"",
      "# GitHub 仓库地址（空仓库）",
      "CREATE_VENV=\"yes\"",
      "# 是否创建虚拟环境：yes/no",
      "",
      "",
      "#=========项目运行，使用方法======",
      "",
      "#主要逻辑写在main，然后运行下面的代码",
      "#python src/main.py",
      "",
      "#def main():",
      "# 在这里编写你的主程序逻辑",
      "#    print(\"Hello from 项目名!\")",
      "",
      "#if __name__ == \"__main__\":",
      "#    main()",
      "",
      "#main() 函数：放置核心逻辑。if __name__ == \"__main__\":当这个文件被直接运行时才执行 main()，被其他模块导入时不会自动运行。#因此，你主要在 main() 函数中编写代码，自己写模块写函数，在这里面导入来用，类似导入别人的模块一样",
      "",
      "#===========项目恢复环境===============",
      "# 恢复环境：激活虚拟环境后执行  pip install -e .",
      "",
      "",
      "#============= 项目删除（Git Bash ）============",
      "# cd 到父目录，执行以下命令永久删除本地项目",
      "# rm -rf python-project-base   # 替换为实际项目名绝对路径",
      "# 同时需在 GitHub 网页上删除远程仓库",
      "",
      "#============== 代码开始 ===============",
      "",
      "set -e",
      "",
      "# ---------- 路径格式转换 ----------",
      "# 将 \"D:/xxx\" 或 \"D:\\xxx\" 转换为 \"/d/xxx\"（Git Bash 风格）",
      "if [[ \"\\$PROJECT_PATH\" =~ ^([A-Za-z]):[\\\\/]?(.*) ]]; then",
      "    drive_letter=\"\\${BASH_REMATCH[1],,}\"   # 转为小写",
      "    rest_path=\"\\${BASH_REMATCH[2]//\\\\//}\"  # 反斜杠转正斜杠",
      "    PROJECT_PATH=\"/\\${drive_letter}/\\${rest_path}\"",
      "fi",
      "",
      "# ---------- Python 命令检测 ----------",
      "if command -v python3 &>/dev/null; then",
      "    PYTHON_CMD=\"python3\"",
      "    elif command -v python &>/dev/null; then",
      "    PYTHON_CMD=\"python\"",
      "else",
      "    echo \"❌ 未找到 Python，请安装 Python 3.8 或更高版本。\"",
      "    exit 1",
      "fi",
      "echo \"🐍 使用 Python 命令：\\$PYTHON_CMD\"",
      "",
      "echo \"🚀 开始自动初始化项目：\\$PROJECT_NAME\"",
      "",
      "# 1. 进入父目录并创建项目文件夹",
      "mkdir -p \"\\$PROJECT_PATH\"",
      "cd \"\\$PROJECT_PATH\"",
      "mkdir -p \"\\$PROJECT_NAME\"",
      "cd \"\\$PROJECT_NAME\"",
      "echo \"✅ 项目目录：\\$(pwd)\"",
      "",
      "# 2. 创建目录结构（可在此处增删）mkdir -p 新建文件夹，touch 文件夹/新建文件",
      "mkdir -p src tests docs scripts",
      "touch src/__init__.py",
      "",
      "# ---------- 创建 .vscode/tasks.json ----------",
      "mkdir -p .vscode",
      "cat > .vscode/tasks.json << 'EOF'",
      "{",
      "  \"version\": \"2.0.0\",",
      "  // VS Code 任务配置（JSONC 格式，支持注释）",
      "  // 使用方法：把需要终端反复写的命令写成任务，通过点击实现代码运行，Ctrl+Shift+P → \"Tasks: Run Task\" → 选择任务",
      "  \"tasks\": [",
      "    {",
      "      \"label\": \"运行测试\", # 任务名称，显示在任务列表中",
      "      \"type\": \"shell\", # 如果是gitbash上，需要另外改一下，默认shell",
      "      \"command\": \"pytest\", # 需要运行的文件名",
      "      \"group\": \"test\", # 属于哪个文件夹",
      "      \"problemMatcher\": [] # 用来解析命令中错误的部分，忽略",
      "    },",
      "    {",
      "      \"label\": \"格式化代码\",",
      "      \"type\": \"shell\",",
      "      \"command\": \"black .\",",
      "      \"problemMatcher\": []",
      "    },",
      "    {",
      "      \"label\": \"启动主程序\",",
      "      \"type\": \"shell\",",
      "      \"command\": \"python src/main.py\",",
      "      \"problemMatcher\": []",
      "    }",
      "  ]",
      "}",
      "EOF",
      "echo \"✅ .vscode/tasks.json 已创建\"",
      "",
      "# 3. 生成 main.py（注意：此处使用不带引号的 heredoc，以便替换 \\$PROJECT_NAME）",
      "cat > src/main.py << EOF",
      "\"\"\"",
      "项目入口模块。",
      "",
      "这是整个项目的启动文件，当你执行 \\`python src/main.py\\` 时，Python 会从这里开始运行代码。",
      "",
      "你可以在这个文件中编写主逻辑，或者导入其他模块。",
      "例如，你可以新建一个 src/utils.py 文件，然后在这里导入它：from utils import my_function",
      "\"\"\"",
      "def main():",
      "    # 在这里编写你的主程序逻辑",
      "    print(\"Hello from \\$PROJECT_NAME!\")",
      "",
      "if __name__ == \"__main__\":",
      "    main()",
      "EOF",
      "",
      "# 4. 生成 .gitignore（保留 .vscode/tasks.json，以便团队共享）",
      "cat > .gitignore << 'EOF'",
      "# Python",
      "__pycache__/",
      "*.py[cod]",
      "*.so",
      ".Python",
      "venv/",
      "env/",
      "ENV/",
      ".venv",
      ".idea/",
      ".vscode/settings.json",
      "*.log",
      "*.pid",
      "*.seed",
      "*.pid.lock",
      ".DS_Store",
      "dist/",
      "build/",
      "*.egg-info/",
      ".eggs/",
      ".pytest_cache/",
      ".coverage",
      "htmlcov/",
      ".tox/",
      ".mypy_cache/",
      ".dmypy.json",
      "dmypy.json",
      "*.prof",
      "EOF",
      "",
      "# 5. 生成 pyproject.toml",
      "cat > pyproject.toml << EOF",
      "# ============================================================",
      "# pyproject.toml 现代 Python 项目配置文件",
      "# 恢复环境：激活虚拟环境后执行  pip install -e .",
      "# ============================================================",
      "",
      "[build-system]",
      "requires = [\"setuptools>=61.0\", \"wheel\"]",
      "build-backend = \"setuptools.build_meta\"",
      "",
      "[project]",
      "name = \"\\$PROJECT_NAME\"",
      "version = \"0.1.0\"",
      "description = \"A Python project\"",
      "authors = [{name = \"Your Name\"}]",
      "readme = \"README.md\"",
      "license = {text = \"MIT\"}",
      "requires-python = \">=3.8\"",
      "dependencies = []   # 在此添加依赖，例如 [\"requests>=2.28\"]",
      "",
      "[tool.setuptools.packages.find]",
      "where = [\"src\"]",
      "EOF",
      "",
      "# 6. 生成 README.md（转义反引号，同时替换变量）",
      "cat > README.md << EOF",
      "# \\$PROJECT_NAME",
      "",
      "## 安装与恢复环境",
      "",
      "1. 创建虚拟环境（可选）：",
      "   \\`\\`\\`bash",
      "   \\$PYTHON_CMD -m venv venv",
      "   \\`\\`\\`",
      "",
      "2. 激活虚拟环境：",
      "   - Windows (Git Bash): \\`source venv/Scripts/activate\\`",
      "   - Linux/Mac: \\`source venv/bin/activate\\`",
      "",
      "3. 安装项目及依赖：",
      "   \\`\\`\\`bash",
      "   pip install -e .",
      "   \\`\\`\\`",
      "   该命令会读取 \\`pyproject.toml\\` 中的依赖并自动安装。",
      "",
      "## 运行项目",
      "",
      "\\`\\`\\`bash",
      "python src/main.py",
      "\\`\\`\\`",
      "",
      "## 使用 VS Code 任务",
      "",
      "- 按 \\`Ctrl+Shift+P\\` → \"Tasks: Run Task\" → 选择任务。",
      "",
      "## 依赖管理",
      "",
      "项目依赖定义在 \\`pyproject.toml\\` 的 \\`[project] dependencies\\` 中。",
      "EOF",
      "",
      "# 7. 生成 LICENSE",
      "cat > LICENSE << EOF",
      "MIT License",
      "",
      "Copyright (c) \\$(date +%Y) Your Name",
      "",
      "Permission is hereby granted, free of charge, to any person obtaining a copy",
      "of this software and associated documentation files (the \"Software\"), to deal",
      "in the Software without restriction, including without limitation the rights",
      "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell",
      "copies of the Software, and to permit persons to whom the Software is",
      "furnished to do so, subject to the following conditions:",
      "",
      "The above copyright notice and this permission notice shall be included in all",
      "copies or substantial portions of the Software.",
      "",
      "THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR",
      "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,",
      "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE",
      "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER",
      "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,",
      "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE",
      "SOFTWARE.",
      "EOF",
      "",
      "# 8. 初始化 Git 并首次提交",
      "if [ -d \".git\" ]; then",
      "    echo \"⚠️ 当前目录已是 Git 仓库，跳过 git init\"",
      "    # 如果暂存区有未提交的更改，则提交（例如重复运行脚本时）",
      "    if ! git diff --cached --quiet; then",
      "        git commit -m \"🎉 更新项目骨架\"",
      "        echo \"✅ 已提交暂存区更改\"",
      "    fi",
      "else",
      "    git init",
      "    git add .",
      "    git commit -m \"🎉 初始项目骨架\"",
      "    echo \"✅ Git 仓库已初始化并完成首次提交\"",
      "fi",
      "",
      "# 9. 可选创建虚拟环境",
      "if [ \"\\$CREATE_VENV\" = \"yes\" ]; then",
      "    if [ -d \"venv\" ]; then",
      "        echo \"ℹ️ 虚拟环境已存在，跳过创建\"",
      "    else",
      "        echo \"🐍 创建虚拟环境...\"",
      "        \\$PYTHON_CMD -m venv venv",
      "    fi",
      "    ",
      "    # 确定虚拟环境 Python 解释器路径",
      "    if [[ \"\\$OSTYPE\" == \"msys\" || \"\\$OSTYPE\" == \"cygwin\" ]]; then",
      "        PYTHON_EXE=\"venv/Scripts/python.exe\"",
      "    else",
      "        PYTHON_EXE=\"venv/bin/python\"",
      "    fi",
      "    ",
      "    # 升级 pip 和 setuptools（使用官方源）",
      "    echo \"📦 升级 pip 和 setuptools ...\"",
      "    \\$PYTHON_EXE -m pip install --upgrade pip setuptools wheel -i https://pypi.org/simple",
      "    ",
      "    # 安装项目（可编辑模式）",
      "    echo \"📦 安装项目（可编辑模式）...\"",
      "    \\$PYTHON_EXE -m pip install -e . -i https://pypi.org/simple || {",
      "        echo \"⚠️ 项目安装失败，但脚本将继续执行推送步骤\"",
      "    }",
      "    echo \"✅ 虚拟环境准备完成\"",
      "else",
      "    echo \"ℹ️ 已跳过虚拟环境创建（CREATE_VENV=\\$CREATE_VENV）\"",
      "fi",
      "",
      "# 10. 关联远程仓库并推送",
      "if git remote | grep -q \"^origin\\$\"; then",
      "    echo \"⚠️ 远程 origin 已存在，更新 URL 为 \\$REPO_URL\"",
      "    git remote set-url origin \"\\$REPO_URL\"",
      "else",
      "    git remote add origin \"\\$REPO_URL\"",
      "fi",
      "",
      "BRANCH=\\$(git symbolic-ref --short HEAD 2>/dev/null || echo \"master\")",
      "echo \"🚀 推送到 origin/\\$BRANCH ...\"",
      "",
      "if ! git push -u origin \"\\$BRANCH\"; then",
      "    echo \"❌ 推送失败，可能原因：远程仓库非空或网络问题。\"",
      "    echo \"   可尝试：\"",
      "    echo \"   1. 如果是非空仓库，先拉取合并： git pull --rebase origin \\$BRANCH\"",
      "    echo \"   2. 检查网络或凭据。\"",
      "    exit 1",
      "fi",
      "",
      "echo \"\"",
      "echo \"🎉 项目初始化完成并已推送到 GitHub！\"",
      "echo \"📂 项目路径：\\$(pwd)\"",
      "echo \"🐍 虚拟环境激活命令：\"",
      "if [[ \"\\$OSTYPE\" == \"msys\" || \"\\$OSTYPE\" == \"cygwin\" ]]; then",
      "    echo \"   source venv/Scripts/activate\"",
      "else",
      "    echo \"   source venv/bin/activate\"",
      "fi"
    ],
    "description": "首先创建github仓库，快速建立一个python项目的普通框架自动上传github备份，结合github项目更新.sh实现项目自动存储"
  },
