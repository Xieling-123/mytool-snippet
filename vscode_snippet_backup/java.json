  "try catch finally": {
    "prefix": "try catch finally",
    "body": [
      "public class Demo {",
      "    public static void main(String[] args) {",
      "//尝试执行，异常捕获，最终一定执行",
      "        try {",
      "            int a = 10;",
      "            int b = 0;",
      "            System.out.println(a / b);   // 除以 0，会出错",
      "        } catch (Exception e) {",
      "            System.out.println(\"出错了: \" + e.getMessage());",
      "        } finally {",
      "            System.out.println(\"无论如何都会执行\");",
      "        }",
      "    }",
      "}"
    ],
    "description": "异常捕获 尝试做，异常捕获，最终一定执行"
  },
